# Copy this file to ".env" and fill in the values.
# Never commit the real .env file (it is listed in .gitignore).

# ---------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------
# The secret Perfox sends as "Authorization: Bearer <MCP_API_KEY>".
# Leave empty ONLY for local testing (then every request is allowed).
MCP_API_KEY=

# Where the server listens. Use 0.0.0.0 to accept outside connections.
HOST=127.0.0.1
PORT=8000

# Keep-alive for Render's free plan (it sleeps after 15 idle minutes).
# Must be the PUBLIC health URL. Leave empty locally to switch it off.
KEEP_ALIVE_URL=
# KEEP_ALIVE_URL=https://drivebot-dczp.onrender.com/health
KEEP_ALIVE_SECONDS=300

# Show FastAPI's automatic API page at /docs. Keep "false" on Render
# (the server is public); "true" is handy on your own computer.
ENABLE_DOCS=false

# ---------------------------------------------------------------
# DriveCarClub API
# ---------------------------------------------------------------
# "mock" = fake test data (default). "live" = the real DriveCarClub API.
# DCC_MODE is for the booking tools (check_dispatch_status, get_chauffeur_details).
DCC_MODE=mock
# DCC_RATE_MODE is for get_fare only. Leave empty to use the same as DCC_MODE.
# Example: real fares with mock bookings = DCC_MODE=mock and DCC_RATE_MODE=live.
DCC_RATE_MODE=

# UAT (test) URLs. Production URLs are still to be confirmed.
DCC_TOKEN_URL=https://drivecarclub.com/CarclubCRMUAT/api/auth/Token
DCC_BOOKING_URL=https://drivecarclub.com/CarclubCRMUAT/Api/Home/DespatchedBooking
DCC_RATE_URL=https://drivecarclub.com/CarclubcrmUAT/Api/Home/GetRate

# HTTP Basic credentials for the Token API.
DCC_USERNAME=
DCC_PASSWORD=

# How the token is sent on each booking lookup.
# Default gives the header:  Authorization: Bearer <token>
# Set DCC_TOKEN_PREFIX to empty if DriveCarClub wants the raw token only.
DCC_TOKEN_HEADER=Authorization
DCC_TOKEN_PREFIX=Bearer

# How long to keep a token if the Token API does not tell us (seconds).
DCC_TOKEN_TTL_SECONDS=3000

# Give up on a DriveCarClub call after this many seconds.
DCC_TIMEOUT_SECONDS=5

# Which booking field is read out as the pickup area: city_Name or location.
# (Not yet confirmed by DriveCarClub. The full address is never used.)
PICKUP_AREA_FIELD=city_Name

# UAT TESTING ONLY: "true" also shows pickups before today (the UAT test
# booking is in the past). Must be "false" in production.
INCLUDE_PAST_BOOKINGS=false

# ---------------------------------------------------------------
# Fares (get_fare tool)
# ---------------------------------------------------------------
# Optional allow-lists, comma-separated, e.g. FARE_CITIES=Gurugram, New Delhi
# Leave empty for no check (DriveCarClub hasn't given us the lists yet).
FARE_CAR_CATEGORIES=
FARE_SERVICE_TYPES=
FARE_CITIES=

# Added to every fare answer.
FARE_NOTE=Tolls, parking and taxes may be extra. For contract rates or an exact quote, please call our customer support team.

# ---------------------------------------------------------------
# OTP for website chat (SOP 5 rule 1)
# ---------------------------------------------------------------
# "mock"  = no SMS is sent and the code is always 123456. TESTING ONLY.
# "plivo" = a real SMS is sent through Plivo (needs the PLIVO_* settings).
OTP_MODE=mock

# A long random secret used to hash the codes (the real code is never
# stored). Make one with:  uv run python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random one is made each time the server starts.
OTP_SECRET=

# Plivo account (Plivo console > Account overview).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The sender ID or Plivo number the SMS comes from.
PLIVO_SENDER_ID=

# The SMS text. {code} is replaced with the 6-digit code.
# India needs an approved template, so change this to match it exactly.
OTP_SMS_TEXT=Your DriveCarClub verification code is {code}. It expires in 5 minutes. Do not share it.

# ---------------------------------------------------------------
# Verification on website chat
# ---------------------------------------------------------------
# "otp"  = the customer proves their number with a code (default).
# "none" = UAT DEMOS ONLY. No code: anyone can check any number's
#          bookings. The server refuses to start with "none" unless
#          DCC_BOOKING_URL contains "UAT". Set back to "otp" after the demo.
VERIFICATION_MODE=otp

# ---------------------------------------------------------------
# Development
# ---------------------------------------------------------------
# DEVELOPMENT ONLY. "true" trusts the phone number Perfox sends on
# website chat without an OTP check. Must be "false" in production.
TRUST_WEB_PHONE=false
